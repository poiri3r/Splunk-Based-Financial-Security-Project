<!-- pom.xml: Maven이 사용할 라이브러리 버전과 실행 파일 제작 방법. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <!-- modelVersion은 POM 형식 버전, groupId/artifactId는 프로젝트 식별자, version은 앱 버전. -->
  <modelVersion>4.0.0</modelVersion><groupId>com.club</groupId><artifactId>bank-backend</artifactId><version>0.1.0</version>
  <!-- Spring Boot 상위 설정을 상속받아 라이브러리 버전을 관리한다. -->
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.5.5</version><relativePath/></parent>
  <!-- 이 프로젝트는 Java 17을 기준으로 컴파일한다. -->
  <properties><java.version>17</java.version></properties>
  <!-- 웹 API, DB/JPA, 인증, 요청 검증, 로컬 H2와 배포용 PostgreSQL 드라이버 -->
  <dependencies>
    <!-- HTTP API와 JSON 변환, 내장 Tomcat 웹 서버를 제공한다. -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <!-- Java 객체와 DB 테이블을 연결하는 JPA 및 Repository 기능. -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
    <!-- 요청 인증과 접근 권한을 검사하는 Spring Security. -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
    <!-- NotBlank, Size 등 요청 입력 검증. -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <!-- 기본 로컬 실행용 메모리 DB. 프로세스를 종료하면 데이터가 사라진다. -->
    <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>runtime</scope></dependency>
    <!-- PostgreSQL 서버와 통신할 JDBC 드라이버. DB 서버 자체를 설치하는 것은 아니다. -->
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
    <!-- SQL 파일의 적용 순서를 기록하고 DB 구조를 변경하는 Flyway. -->
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
    <!-- Flyway의 PostgreSQL 지원 모듈. -->
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
    <!-- 테스트 작성·실행용 도구. scope=test는 테스트 단계에만 사용한다. -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <!-- 보안 기능 테스트용 도구. 의존성이 있다고 테스트가 작성된 것은 아니다. -->
    <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <!-- mvn package 명령으로 실행 가능한 jar를 만든다. -->
  <build><plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin></plugins></build>
</project>
